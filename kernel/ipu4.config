##
## Surface Book 3: Intel IPU4P (Ice Lake) camera ISP, downstream driver
##

CONFIG_VIDEO_INTEL_IPU=m
CONFIG_VIDEO_INTEL_IPU4P=y
CONFIG_VIDEO_INTEL_IPU_SOC=y
CONFIG_VIDEO_INTEL_IPU_FW_LIB=y
# IPU6/IPU7 compete with IPU4P for the CSE on this machine
# CONFIG_VIDEO_INTEL_IPU6 is not set
# CONFIG_VIDEO_INTEL_IPU7 is not set

##
## Rust is not needed for this kernel; avoids the rust toolchain makedepends
##

# CONFIG_RUST is not set
